# Settings that belong to the serverless target only. Copy to terraform.tfvars
# (gitignored) and edit. Everything here has a working default, so an empty file
# is valid — the values below are the ones worth knowing about.
#
# Shared settings (aws_region, aws_profile, project, bedrock_model_id,
# bedrock_region) live in ../shared.tfvars and are passed on the command line:
#
#   terraform -chdir=infra/serverless apply -var-file=../shared.tfvars

# ── Phase 0: verifying the deployment before trusting it ──────────────────────
#
# `canned` streams a fixed reply at a known, fixed cadence with no AWS call at
# all. That makes it the sharper instrument for checking that the response
# streams end to end: a real model's cadence is unknown, so a burst arriving all
# at once proves nothing, whereas with `canned` it proves something is buffering.
#
# Flip to "bedrock" once streaming is confirmed.
# reply_source       = "canned"
# word_delay_seconds = 0.06

# ── Packaging ─────────────────────────────────────────────────────────────────

# Must match what scripts/release-api.sh builds — one variable drives both,
# because a mismatch fails at function-create time with an architecture error.
#
# x86_64 is the default because an arm64 image builds under QEMU on an x86
# workstation and `uv sync` under emulation is slow. arm64 is cheaper per
# millisecond; switch once the deployment is stable or releases move to CI.
# lambda_architecture = "x86_64"

# Read only when the function is first created. Afterwards releases update the
# function by digest and Terraform ignores image_uri, so editing this does
# nothing to an existing deployment.
# image_tag = "bootstrap"

# ── Sizing ────────────────────────────────────────────────────────────────────

# Memory also buys proportional CPU, and this function's cold start is CPU-bound
# (importing FastAPI and boto3), so a larger size can finish init sooner and cost
# less overall. Measure Init Duration in the REPORT log lines before changing it.
# memory_size_mb = 1536

# Must exceed botocore's 60 s read timeout plus init. Also a cost ceiling: Lambda
# bills the full duration and does not stop a stream when the viewer disconnects.
# timeout_seconds = 120

# ── Asynchronous replies ──────────────────────────────────────────────────────
#
# The worker is this same image, deployed a second time and mounted as a worker.
# It runs for as long as a reply takes with nobody holding a connection open, so
# it is sized separately from the API.

# The worker's cold start is the one a person actually waits through on the
# asynchronous path, and init is CPU-bound — so this is the first number to raise
# if the wait is too long. Measure Init Duration in its REPORT lines first.
# worker_memory_size_mb = 1536

# The only thing that can stop a stalled reply. The application deliberately does
# not enforce its own budget, because it cannot: a worker blocked reading from
# Bedrock is uninterruptible, so an in-process timeout would fail to fire in
# exactly the case it existed for. Must exceed bedrock_read_timeout_seconds,
# which Terraform checks.
# worker_timeout_seconds = 300

# How long botocore waits on a silent Bedrock socket. This is the real ceiling on
# how long a stalled reply occupies a worker.
# bedrock_read_timeout_seconds = 60

# How long Lambda may retry delivering a job before discarding it — the one thing
# genuinely given up by using Lambda's event queue instead of running a queue.
# Under a sustained throttle, jobs are retried and then dropped, surfacing to the
# client as a deadline failure and to us as the worker-events-dropped alarm.
#
# 300 s is a judgement about people, not about AWS: the maximum is six hours, but
# a reply arriving fifteen minutes late is worthless, and "busy, try again" beats
# a silent wait. Raise it if AsyncEventAge shows deliveries near the limit.
# worker_event_age_seconds = 300

# ── Error alerts ──────────────────────────────────────────────────────────────

# Where the two error alarms mail. Set the real value in terraform.tfvars next to
# this file — gitignored, and auto-loaded with no -var-file flag.
#
# Not in ../shared.tfvars: that file is for settings both stacks declare, and
# ../server has no alert_email, so a value there makes every server-stack command
# warn about an undeclared variable. Harmless, permanent, and on the wrong stack.
#
# Leave it empty and Terraform still creates the topic and both alarms with no
# subscriber; the `alerts_topic_arn` output prints the command to subscribe by
# hand.
#
# Either way, SNS mails a confirmation link and delivers nothing until it is
# clicked. Check with the `alerts_subscription_check_command` output: a
# PendingConfirmation subscription is not an alert.
# alert_email = "alerts@example.com"

# ── Cost and retention ────────────────────────────────────────────────────────

# Set explicitly because the CloudWatch default is "never expire", which makes
# logs the largest line item on an otherwise nearly-free deployment.
# log_retention_days = 14

# The cheapest class still covers North America and Europe.
# price_class = "PriceClass_100"

# Bounds how long a billed — and possibly abandoned — stream can run.
# bedrock_max_output_tokens = 1024

# How long an asynchronous reply stays readable. One hour covers a page refresh,
# a dropped connection and a closed laptop lid, which is the durability the
# transport exists for, while keeping almost nothing at rest.
#
# This sets the *expiry*, not the deletion: DynamoDB removes expired items only
# typically within 48 hours, so the honest figure for how long a reply is at rest
# is up to about 49 hours. Replies routinely quote the question back.
# job_retention_seconds = 3600

# How long a failed job's record stays on the failure queue. Long enough to
# outlast a weekend, so a Friday alarm can still be acted on — and no longer,
# because these records carry the prompt and the conversation history. That is
# the one place this design leaves them at rest.
# worker_failure_retention_seconds = 345600
