# Copy to .env and adjust. Committed as documentation — no real values here.

# ── api container ────────────────────────────────────────────────
# Comma-separated allowed origins. Leave empty in production: Caddy serves the
# bundle and the API from one origin, so no CORS middleware is needed.
# For frontend dev against a host Vite server:
#   CHAT_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CHAT_CORS_ALLOW_ORIGINS=
CHAT_MAX_PROMPT_CHARS=4000
CHAT_WORD_DELAY_SECONDS=0.06

# ── host wiring (local only) ─────────────────────────────────────
API_HOST_PORT=8000

# ── caddy (not read until the TLS phase) ─────────────────────────
# Production: the Elastic IP, e.g. SITE_ADDRESS=203.0.113.10
# Local:http://localhost  (plain HTTP, no certificate requested)
SITE_ADDRESS=http://localhost
ACME_EMAIL=you@example.com

# Bedrock
# can be either bedrock or canned
CHAT_REPLY_SOURCE= 
# model id of the model you want to use from AWS Bedrock
CHAT_BEDROCK_MODEL_ID=
# Region of bedrock model
CHAT_BEDROCK_REGION=
CHAT_BEDROCK_MAX_OUTPUT_TOKENS=
CHAT_BEDROCK_TEMPERATURE=
CHAT_MAX_HISTORY_MESSAGES=
# persona of the model you want
CHAT_SYSTEM_PROMPT=