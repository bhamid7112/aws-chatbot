{
  "name": "aws-chatbot-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Streaming chat UI — Clean Architecture, React, Server-Sent Events.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
